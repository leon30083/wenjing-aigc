# MCP 工具所需的环境变量
# 复制此文件为 .env.mcp 并填入真实的 API 密钥

# GitHub Token（用于 Z-Read 访问私有仓库）
# 获取方式: GitHub Settings → Developer settings → Personal access tokens → Tokens (classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Gemini API Key（用于 Context7 查询文档）
# 获取方式: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxx

# OpenAI API Key（可选，用于某些 MCP 工具）
# 获取方式: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxx
